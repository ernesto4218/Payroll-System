<!-- form -->
<div id="recordsparent" class="z-10 hidden backdrop-brightness-80 backdrop-blur-sm fixed w-full h-full items-center justify-center">
    <div class="w-[90%] h-[90%] bg-white rounded-2xl flex flex-col items-start overflow-y-auto">
        <div class="flex w-full justify-between pl-4 items-center border-b border-gray-400">

            <form id="filteremployeerecordform" class="min-w-sm p-2 flex flex-row gap-2 items-center justify-start">
                <select id="monthselectorrecords" name="month" class="flex min-w-[150px] px-3 py-2 bg-neutral-secondary-medium border border-default-medium text-heading text-sm rounded-base focus:ring-brand focus:border-brand shadow-xs placeholder:text-body">
                    <option value="" selected>Month</option>
                    <% dtrmonths.forEach(month => { %>
                        <option value="<%= month.value %>"><%= month.value %></option>
                    <% }) %>
                </select>
                <select id="yearselectorrecords" name="year" class="flex min-w-[150px] px-3 py-2 bg-neutral-secondary-medium border border-default-medium text-heading text-sm rounded-base focus:ring-brand focus:border-brand shadow-xs placeholder:text-body">
                    <option value="" selected>Year</option>
                    <% dtryear.forEach(year => { %>
                        <option value="<%= year.value %>"><%= year.value %></option>
                    <% }) %>
                </select>

                <button id="filterdtremployeebtn" type="button" class="hidden items-center justify-center flex-row gap-2 text-xs bg-neutral-secondary-medium border border-default-medium text-heading box-border focus:ring-2 focus:ring-brand-medium shadow-xs font-medium leading-5 rounded-xl px-2 py-2 focus:outline-none">
                    Filter

                    <svg class="w-4 h-4 text-gray-800" aria-hidden="true" xmlns="http://www.w3.org/2000/svg" width="24" height="24" fill="none" viewBox="0 0 24 24">
                        <path stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 12H5m14 0-4 4m4-4-4-4"/>
                    </svg>

                </button>
            </form>


            <svg id="closerecordsform" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 384 512" class="w-10 h-10 mr-4 p-3 text-black hover:bg-gray-300 rounded-xl cursor-pointer" fill="currentColor"><path d="M342.6 150.6c12.5-12.5 12.5-32.8 0-45.3s-32.8-12.5-45.3 0L192 210.7 86.6 105.4c-12.5-12.5-32.8-12.5-45.3 0s-12.5 32.8 0 45.3L146.7 256 41.4 361.4c-12.5 12.5-12.5 32.8 0 45.3s32.8 12.5 45.3 0L192 301.3 297.4 406.6c12.5 12.5 32.8 12.5 45.3 0s12.5-32.8 0-45.3L237.3 256 342.6 150.6z"/></svg>
        </div>

        <div class="p-4 overflow-y-auto mb-4 w-full" id="table-record-container">
            <table id="search-table-records">
                <thead>
                    <tr>
                        <th>
                            <span class="flex items-center">
                                Day

                            </span>
                        </th>
                        <th>
                            <span class="flex items-center">
                                Morning Time In

                            </span>
                        </th>
                        <th>
                            <span class="flex items-center">
                                Morning Time Out

                            </span>
                        </th>
                        <th>
                            <span class="flex items-center">
                                Afternoon Time In

                            </span>
                        </th>
                        <th>
                            <span class="flex items-center">
                                Afternoon Time Out

                            </span>
                        </th>
                        <th>
                            <span class="flex items-center">
                                Action
                            </span>
                        </th>
                    </tr>
                </thead>
                <tbody>
                    <tr>
                        <td class="text-center"></td>
                        <td class="text-center"></td>
                        <td class="text-center"></td>
                        <td class="text-center"></td>
                        <td class="text-center"></td>
                        <td class="text-center"></td>
                    </tr>
                </tbody>

            </table>
        </div>
    </div>
</div>